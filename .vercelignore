# Ignore Go backend and runtime files so Vercel does not attempt to build Go Serverless Functions.
# Patterns MUST be root-anchored. Unanchored names like `i18n/` also match
# `web/default/src/i18n` and break the frontend build on Vercel.
/*.go
/go.mod
/go.sum
/bin/
/cmd/
/common/
/constant/
/controller/
/data/
/dto/
/electron/
/i18n/
/logger/
/logs/
/middleware/
/model/
/oauth/
/pkg/
/relay/
/router/
/service/
/setting/
/types/
/Dockerfile*
/docker-compose*
/run.ps1
/makefile
