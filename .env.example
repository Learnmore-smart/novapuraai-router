# Local development defaults
# Copy this file to .env and adjust the values you need.

# Public / non-secret values
PORT=3000
GIN_MODE=debug
DEBUG=true
FRONTEND_BASE_URL=http://localhost:3000
SQLITE_PATH=./data/new-api.db
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000
SQL_MAX_LIFETIME=60
ERROR_LOG_ENABLED=true
SYNC_FREQUENCY=60
MEMORY_CACHE_ENABLED=false
BATCH_UPDATE_ENABLED=false
BATCH_UPDATE_INTERVAL=5
UPDATE_TASK=true
RELAY_TIMEOUT=840
RELAY_IDLE_CONN_TIMEOUT=90
STREAMING_TIMEOUT=300
TLS_INSECURE_SKIP_VERIFY=false
GEMINI_VISION_MAX_IMAGE_NUM=16
GENERATE_DEFAULT_TOKEN=false
COHERE_SAFETY_SETTING=NONE
GET_MEDIA_TOKEN=true
GET_MEDIA_TOKEN_NOT_STREAM=false
DIFY_DEBUG=true
ENABLE_PPROF=false
PYROSCOPE_APP_NAME=new-api
PYROSCOPE_MUTEX_RATE=5
PYROSCOPE_BLOCK_RATE=5
NODE_NAME=novapura-node-1
NODE_TYPE=master

# Stripe recurring subscription contract. Disabled by default.
# Runtime selects the Test catalog for non-release GIN_MODE and the Production
# catalog for GIN_MODE=release. Public overrides are optional but, when set,
# must exactly match the selected fixed catalog. Do not put Stripe secrets here.
STRIPE_SUBSCRIPTION_ENABLED=false
# STRIPE_SUBSCRIPTION_ACCOUNT_ID=
# STRIPE_SUBSCRIPTION_PRODUCT_ID=
# STRIPE_SUBSCRIPTION_FOUNDER_PRICE_ID=
# STRIPE_SUBSCRIPTION_STANDARD_PRICE_ID=
# STRIPE_SUBSCRIPTION_PORTAL_CONFIGURATION_ID=

# Secrets / values you must decide
SESSION_SECRET=change_me_to_a_long_random_string
# CRYPTO_SECRET is used to encrypt channel credentials at rest (enc:v1:…); set a stable value in production.
# CRYPTO_SECRET=change_me_crypto_secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# Transactional email. Complete environment credentials override encrypted
# Dashboard-managed credentials. Never put real credential values in this example.
EMAIL_PROVIDER=ses
EMAIL_FROM_ADDRESS=no-reply@novapuraai.com
EMAIL_FROM_NAME=NovaPuraAI
AWS_SES_REGION=ap-southeast-1
# Optional environment/Secret Manager overrides used by the transactional runtime:
# AWS_SES_ACCESS_KEY_ID
# AWS_SES_SECRET_ACCESS_KEY
# AWS_SES_SESSION_TOKEN (optional for temporary credentials)

# Legacy SMTP compatibility. Transactional verification, password-reset,
# receipt, and notification emails do not use this transport.
SMTP_SERVER=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
SMTP_ACCOUNT=
# SMTP_TOKEN is legacy and must also be injected from Secret Manager if used.
SMTP_TOKEN=
SMTP_FROM=no-reply@novapuraai.com
# Legacy SMTPServer/SMTPPort/SMTPAccount/SMTPToken/SMTPFrom names remain supported for values.

# GitHub OAuth (MVP social login).
# GITHUB_OAUTH_CLIENT_SECRET is environment/Secret Manager only — never DB / never API.
GITHUB_OAUTH_ENABLED=true
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Cloudflare Turnstile.
# Site key + hostnames are admin-editable; TURNSTILE_SECRET_KEY is env/Secret Manager only.
TURNSTILE_CHECK_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=novapuraai.com,localhost

# ---------------------------------------------------------------------------
# Stripe one-time API Credits top-up (sandbox account only for MVP)
# Account: acct_1Tta8mPKe8UWYDw1 (NovaPuraAI 沙盒) — livemode must stay false.
# Product: create/reuse "NovaPuraAI API Credits Top-up" (example prod_UtfurOrHIdxxhP)
# Never put sk_live / pk_live in non-production.
# ---------------------------------------------------------------------------
# STRIPE_TOPUP_ENABLED=true
# Store server keys in Secret Manager, never in this file when it is committed.
# Non-release processes automatically use this Test profile.
# Prefer a least-privilege restricted sandbox key (rk_test_...); sk_test_... is also accepted.
# STRIPE_TEST_SECRET_KEY=rk_test_...
# Optional for hosted Checkout; only needed by future client-side Stripe.js/Elements flows.
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_TEST_TOPUP_PRODUCT_ID=prod_...
# STRIPE_TEST_ACCOUNT_ID=acct_...
# Release processes use this Production profile only when SESSION_COOKIE_TRUSTED_URL
# is https://www.novapuraai.com. Other release domains fail closed.
# STRIPE_PROD_SECRET_KEY=rk_live_...
# STRIPE_PROD_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PROD_WEBHOOK_SECRET=whsec_...
# STRIPE_PROD_TOPUP_PRODUCT_ID=prod_...
# STRIPE_PROD_ACCOUNT_ID=acct_...
# STRIPE_FX_CNY_PER_USD=7.3
# STRIPE_FX_CAD_PER_USD=1.37
# Legacy Test aliases remain accepted: STRIPE_API_SECRET, STRIPE_WEBHOOK_SECRET,
# STRIPE_TOPUP_PRODUCT_ID, STRIPE_ACCOUNT_ID, StripeApiSecret

# Leave these blank for local SQLite mode.
# Set SQL_DSN if you want MySQL or PostgreSQL instead of SQLite.
SQL_DSN=
LOG_SQL_DSN=

# Leave this blank unless you want Redis enabled.
REDIS_CONN_STRING=

# Optional secrets for monitoring or hosted services.
# PYROSCOPE_URL=
# PYROSCOPE_BASIC_AUTH_USER=
# PYROSCOPE_BASIC_AUTH_PASSWORD=

# Uncomment only if you need these integrations later.
# LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
# LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user
# TRUSTED_REDIRECT_DOMAINS=
# POSTGRES_USER=root
# POSTGRES_PASSWORD=replace_with_strong_password
# POSTGRES_DB=new-api
# REDIS_PASSWORD=replace_with_strong_password
# NEW_API_IMAGE=calciumion/new-api:latest

# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=
# GOOGLE_ANALYTICS_ID=
# CHANNEL_TEST_ENABLED=false
# TEST_MYSQL_DSN=
# TEST_POSTGRES_DSN=

# What to do when you need something later:
# - For a local no-Docker setup, keep SQL_DSN and REDIS_CONN_STRING blank and use SQLITE_PATH.
# - For MySQL or PostgreSQL, fill SQL_DSN and optionally LOG_SQL_DSN.
# - For Redis, fill REDIS_CONN_STRING and keep the Redis password secret if you deploy it yourself.
# - For production HTTPS cookies, set SESSION_COOKIE_SECURE=true and add your HTTPS origin to SESSION_COOKIE_TRUSTED_URL.
# - For analytics or monitoring, fill PYROSCOPE_URL, UMAMI_WEBSITE_ID / UMAMI_SCRIPT_URL, or GOOGLE_ANALYTICS_ID only if you actually use them.
# - For docker compose, uncomment the POSTGRES_* / REDIS_PASSWORD / NEW_API_IMAGE values you need.
