{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "export PATH=\"$HOME/.bun/bin:$PATH\" && (which bun || curl -fsSL https://bun.sh/install | bash) && export PATH=\"$HOME/.bun/bin:$PATH\" && cd .. && bun install --frozen-lockfile",
  "buildCommand": "export PATH=\"$HOME/.bun/bin:$PATH\" && bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://novapuraai-router-225072369047.asia-east1.run.app/api/:match*"
    },
    {
      "source": "/v1/:match*",
      "destination": "https://novapuraai-router-225072369047.asia-east1.run.app/v1/:match*"
    },
    {
      "source": "/mj/:match*",
      "destination": "https://novapuraai-router-225072369047.asia-east1.run.app/mj/:match*"
    },
    {
      "source": "/pg/:match*",
      "destination": "https://novapuraai-router-225072369047.asia-east1.run.app/pg/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
